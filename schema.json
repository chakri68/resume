{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "personal",
    "summary",
    "skills",
    "experience",
    "projects",
    "education",
    "achievements",
    "keywords",
    "footer"
  ],
  "properties": {
    "personal": {
      "type": "object",
      "required": ["name", "contact"],
      "properties": {
        "name": {
          "type": "string"
        },
        "tagline": {
          "type": "string",
          "description": "Optional. Short role line, parts separated by ' · '. Used by the alternate designs; falls back to the first job title."
        },
        "contact": {
          "type": "object",
          "required": ["github", "linkedin", "email", "phone"],
          "properties": {
            "github": {
              "$ref": "#/definitions/contact"
            },
            "linkedin": {
              "$ref": "#/definitions/contact"
            },
            "email": {
              "$ref": "#/definitions/contact"
            },
            "phone": {
              "$ref": "#/definitions/contact"
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": {
          "type": "string"
        }
      }
    },
    "skills": {
      "type": "object",
      "required": ["categories"],
      "properties": {
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "items"],
            "properties": {
              "title": {
                "type": "string"
              },
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "highlights": {
      "type": "array",
      "description": "Optional. Headline numbers the alternate designs use as pull quotes. Omit it and those blocks simply don't render.",
      "items": {
        "type": "object",
        "required": ["value", "label"],
        "properties": {
          "value": {
            "type": "string",
            "description": "The number, set large, e.g. '−95%'."
          },
          "label": {
            "type": "string",
            "description": "What the number measures."
          },
          "source": {
            "type": "string",
            "description": "Company it came from; matched against experience[].company."
          },
          "quote": {
            "type": "string",
            "description": "Optional sentence form, for designs that want a quote instead of a number."
          }
        }
      }
    },
    "experience": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["company", "title", "location", "period", "achievements"],
        "properties": {
          "company": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "period": {
            "type": "string"
          },
          "headline": {
            "type": "string",
            "description": "Optional. Newspaper-style headline for this job (Broadsheet design). Falls back to '<title>, <company>'."
          },
          "deck": {
            "type": "string",
            "description": "Optional. One-line standfirst under the headline (Broadsheet design)."
          },
          "achievements": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "positions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["title", "period", "achievements"],
              "properties": {
                "title": {
                  "type": "string"
                },
                "period": {
                  "type": "string"
                },
                "achievements": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description", "url"],
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "education": {
      "type": "object",
      "required": ["institution", "degree", "gpa", "period", "location"],
      "properties": {
        "institution": {
          "type": "string"
        },
        "degree": {
          "type": "string"
        },
        "gpa": {
          "type": "string"
        },
        "period": {
          "type": "string"
        },
        "location": {
          "type": "string"
        }
      }
    },
    "achievements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "description"],
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "keywords": {
      "type": "string"
    },
    "footer": {
      "type": "object",
      "required": ["copyright", "lastUpdated"],
      "properties": {
        "copyright": {
          "type": "string"
        },
        "lastUpdated": {
          "type": "string"
        }
      }
    }
  },
  "definitions": {
    "contact": {
      "type": "object",
      "required": ["text", "url"],
      "properties": {
        "text": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    }
  }
}
